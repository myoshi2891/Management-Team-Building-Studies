{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(node:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bunx:*)",
      "Bash(npx markdownlint-cli2:*)",
      "WebSearch",
      "Skill(nuxt-page-migration)",
      "Skill(markdown-formatter)",
      "Skill(pre-commit-check)"
    ]
  }
}
